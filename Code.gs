    observed:observedSubmission || Number.isFinite(score),
    source:'BRIGHTSPACE_LIVE_API',
    submission:{
      fileUpload:st === 0 || st === 4,
      textSubmission:st === 1 || st === 4,
      onPaper:st === 2,
      observedInPerson:st === 3,
      submissionType:Number.isFinite(st) ? st : null
