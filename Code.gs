      var sameId=String(r.topicId||'') && String(r.topicId||'')===String(best.id||'');
      var sameTitle=qaCleanName_(r.topicTitle||'') && qaCleanName_(r.topicTitle||'')===qaCleanName_(best.title||'');
      var f=String(r.family||'').toUpperCase();
