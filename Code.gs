    refs.forEach(function(ref){var value=String(ref||'').trim();if(value && !/^cti-aggregate:/.test(value) && ids.indexOf(value)<0)ids.push(value);});
  });
  return ids;
}

function qaObsoleteAggregateStageGuard_(result, baseline, priorNonRaw) {
