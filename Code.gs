function exportMasterManifestAsGoogleSheet(treeJsonStr, fileName) {
  authorize_('editor');
  try {
    var tree = JSON.parse(treeJsonStr);
    var rows = [["Level", "Name", "Assignment_Tool", "System Format", "Ingestion Status"]];
    function traverse(nodes, currentLevel) {
      for (var i = 0; i < nodes.length; i++) {
        var node = nodes[i], name = node.title || "Untitled Resource", type = node.type || "unknown", tool = "Reading"; 
        if (type.indexOf('imsqti') > -1) tool = "Assessment"; else if (type.indexOf('assignment') > -1) tool = "Assignment"; else if (type.indexOf('imsdt') > -1) tool = "Discussion"; else if (type.indexOf('imsbasiclti') > -1) tool = "LTI"; else if (type.indexOf('imswl') > -1) tool = "URL"; else if (type === "plugin") tool = "Plugin"; else if (type === "folder") tool = "Module";
        var status = node.autoDeleted ? "Auto-Deleted" : "Included";
