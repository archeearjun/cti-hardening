function qaPerceptualHashSimilarity_(left, right) {
    var a = String(left || ''), b = String(right || '');
    if (!a || !b || a.length !== b.length) return null;
    var distance = 0;
    for (var i = 0; i < a.length; i++) if (a.charAt(i) !== b.charAt(i)) distance++;
    return 1 - (distance / a.length);
