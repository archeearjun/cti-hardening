{
  "manifest_version": 3,
  "name": "CTI Coursera Item Refresh",
  "version": "1.0.1",
  "minimum_chrome_version": "120",
  "description": "Refresh one Coursera authoring item into CTI using your signed-in browser. Runs only when requested from CTI.",
  "key": "",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": [
    "https://www.coursera.org/*",
    "https://cti-hardening.pages.dev/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://cti-hardening.pages.dev/*"],
      "js": ["cti-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
