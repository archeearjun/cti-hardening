{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cti-coursera-extractor",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "CTI_DB",
      "database_name": "cti-workspace",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_RUNTIME",
        "class_name": "WorkspaceRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "workspace-runtime-v1",
      "new_sqlite_classes": ["WorkspaceRuntime"]
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "cti-extraction-artifacts"
    }
  ],
  "workflows": [
    {
      "name": "cti-coursera-extraction",
      "binding": "EXTRACTION_WORKFLOW",
      "class_name": "CourseraExtractionWorkflow"
    }
  ]
}
