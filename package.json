{
  "name": "cti-evidence-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run generate && vite --host 0.0.0.0",
    "generate": "node tools/generate-compat.mjs && node tools/generate-source-scanner.mjs && node tools/generate-owner-report.mjs",
    "export:gas": "node tools/export-gas.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run generate && node tools/check.cjs && node tools/hardening-check.cjs && node --test tests/*.test.mjs",
    "test:browser:package": "node tools/browser-package-check.mjs",
    "test:browser:workspace": "node tools/browser-workspace-check.mjs",
    "test:browser:ux": "node tools/browser-ux-check.mjs",
    "test:browser:owner": "node tools/browser-owner-actions-check.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@xmldom/xmldom": "0.9.12",
    "jose": "6.1.0",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
